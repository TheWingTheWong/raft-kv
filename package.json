{
  "name": "raft-kv",
  "version": "0.1.0",
  "description": "A Raft-replicated key-value store in TypeScript, verified by a deterministic simulator and a linearizability checker.",
  "license": "MIT",
  "author": "Ansorjon Juraev",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "raft-kv": "dist/cli/kv.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "chaos": "vitest run test/chaos.test.ts",
    "cluster": "npm run build && node dist/cli/cluster.js",
    "kv": "node dist/cli/kv.js",
    "mutants": "node scripts/mutants.mjs"
  },
  "keywords": [
    "raft",
    "consensus",
    "distributed-systems",
    "key-value",
    "linearizability",
    "simulation"
  ],
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
